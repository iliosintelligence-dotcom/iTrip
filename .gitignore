# =============================================================================
# GO SPECIFIC - GENERATED FILES
# =============================================================================
# Stringer
*_string.go

# Mockery
*_mock.go
mocks/

# Wire
wire_gen.go

# GraphQL
*_generated.go

# =============================================================================
# SPECIFIC TO TAXIFEVER/ITRIP
# =============================================================================
# Generated protobuf paths
**/proto/go/**/*.pb.go
**/proto/go/**/*.pb.gw.go
**/proto/go/**/*.pb.micro.go
**/proto/go/**/*.pb.ts
**/proto/go/**/*.pb.js

# Service-specific generated
services/*/internal/handler/*.pb.go
services/*/internal/handler/*.pb.gw.go

# Kubernetes generated
**/kubernetes/generated/
**/k8s/generated/

# =============================================================================
# ALLOWLIST - KEEP THESE (remove from ignore if present)
# =============================================================================
!/.github/workflows/
!/.github/dependabot.yml
!/.github/dependabot.yaml
!/.github/CODEOWNERS
!/.github/PULL_REQUEST_TEMPLATE.md
!/.github/ISSUE_TEMPLATE/
!/.github/SECURITY.md
!/.github/FUNDING.yml

