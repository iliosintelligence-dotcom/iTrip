*.tar.gz
*.tar.xz
*.tar.bz2
*.tbz2
*.zip
*.zipx
*.rar
*.7z
*.gz
*.bz2
*.xz
*.lzma
*.lz
*.zst

*.exe
*.msi
*.dmg
*.pkg
*.deb
*.rpm
*.apk
*.ipa

*.pdf
*.doc
*.docx
*.xls
*.xlsx
*.ppt
*.pptx

# Media
*.mp4
*.mkv
*.avi
*.mov
*.wmv
*.flv
*.webm
*.mp3
*.wav
*.flac
*.ogg
*.jpg
*.jpeg
*.png
*.gif
*.bmp
*.tiff
