# =============================================================================
# iTrip / TaxiFever - Comprehensive .gitignore
# Go Microservices + Protobuf + Terraform + Docker + Kubernetes
# =============================================================================

# =============================================================================
# GO
# =============================================================================
# Compiled binaries
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.prof
*.out
coverage.out
coverage.html

# Build artifacts
bin/
dist/
build/
out/
*.a

# Dependencies (NEVER commit)
vendor/
**/vendor/

# Go module cache
go.sum
# go.mod IS committed (required)

# Test files (generated)
*_test.go
*_test.go~

# Profiling
*.pprof
*.prof

# =============================================================================
# NODE.JS / FRONTEND (if any)
# =============================================================================
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*

# Build outputs
dist/
build/
.next/
.out/
*.tsbuildinfo

# Package locks (COMMIT these for reproducible builds)
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# =============================================================================
# PROTOBUF / GRPC GENERATED CODE
# =============================================================================
# NEVER commit generated code - regenerate with: make proto / buf generate
**/*.pb.go
**/*.pb.gw.go
**/*.pb.micro.go
**/*.pb.ts
**/*.pb.js
**/*.pb.d.ts
**/*.grpc.pb.go
**/*.pem.go

# Protobuf well-known types (generated)
google/protobuf/*.pb.go

# =============================================================================
# DOCKER
# =============================================================================
.docker/
docker-compose.override.yml
docker-compose.*.local.yml
.dockerignore

# Built images (never commit)
*.tar
*.tar.gz
*.tar.xz

# =============================================================================
# KUBERNETES / HELM / KUSTOMIZE
# =============================================================================
# Generated manifests (use helm template / kustomize build in CI)
**/manifests/
**/rendered/
*.generated.yaml

# Helm
charts/**.tgz
*.lock
# Chart.lock IS committed (helm dependency update)

# Kustomize
kustomization.yaml
# kustomization.yaml IS committed

# =============================================================================
# TERRAFORM
# =============================================================================
.terraform/
*.tfstate
*.tfstate.*
*.tfstate.backup
*.tfplan
*.tfplan.out
.terraform.lock.hcr

# Provider cache
.terraform/providers/
*.provider

# State files (NEVER commit)
*.tfstate
*.tfstate.*
*.tfstate.backup
*.tfstate.lock.info

# =============================================================================
# KUBERNETES / ARGOCD
# =============================================================================
# Generated manifests (use kubectl kustomize / helm template)
*.generated.yaml
**/overlays/**/rendered/

# SealedSecrets (encrypted - OK to commit sealed, NOT the key)
# sealed-secrets-key.pem  <- NEVER commit

# =============================================================================
# VAULT / SECRETS / CERTS
# =============================================================================
# NEVER commit secrets!
*.pem
*.key
*.crt
*.csr
*.p12
*.pfx
*.jks
*.keystore
*.truststore

# Secret files
*.env
.env
.env.local
.env.*.local
.env.production
.env.staging
.env.development
*.secret
*.secret.yaml
*.secret.yml

# Vault
*.unseal
*.token
*.unseal_token

# SSH
*.pem
id_rsa*
id_ed25519*
id_ecdsa*
*.ppk

# =============================================================================
# LOGS & TEMP FILES
# =============================================================================
*.log
*.log.*
*.log.*
*.log.*
*.tmp
*.tmp.*
*.temp
*.temp.*
*.swp
*.swo
*~
*~
.cache/
.cache/
tmp/
temp/
.tmp/
*.bak
*.backup
*.orig

# =============================================================================
# IDE / EDITORS
# =============================================================================
# VS Code
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json

# JetBrains
.idea/
*.iml
*.ipr
*.iws

# Vim
*.swp
*.swo
*~

# VS Code (keep settings)
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/extensions.json

# =============================================================================
# OS
# =============================================================================
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.Spotlight-V100
.Trashes
ehthumbs.db
*.app.dSYM

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# =============================================================================
# GIT / VERSION CONTROL
# =============================================================================
.git/
.gitignore
.gitattributes
.gitmodules
.gitkeep

# =============================================================================
# CI/CD
# =============================================================================
# GitHub Actions (keep workflows)
# .github/workflows/ - KEEP

# GitLab CI
.gitlab-ci.yml - KEEP

# Jenkins
Jenkinsfile - KEEP

# CircleCI
.circleci/ - KEEP

